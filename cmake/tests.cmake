# Тесты и метки ctest (эталон 9.1). Имена <слой>.<объект>.<свойство>. Окружение всех тестов —
# offscreen Qt и каталог данных в дереве сборки (ottisk_test_env.cmake подключается к ctest через
# TEST_INCLUDE_FILES и задаёт ENV для всех тестов, включая открытые gtest_discover_tests PRE_TEST).
# gtest пишет XML по тесту в build/<пресет>/gtest-xml — оттуда scope_report.py берёт свойства OT_FEATURE.
include(GoogleTest)
set(OTTISK_TEST_DATA_DIR "${CMAKE_BINARY_DIR}/test-data")
set(OTTISK_RELEASE_TEST_TARGETS render_tests)

# gtest-исполняемый файл из каталога: ottisk_gtest_exe(<цель> <каталог> <префикс> <метки> <таймаут> <библиотеки…>)
function(ottisk_gtest_exe target dir prefix labels timeout)
  file(GLOB_RECURSE _src CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/${dir}/*.cpp")
  if(NOT _src)
    return()
  endif()
  add_executable(${target} ${_src})
  target_link_libraries(${target} PRIVATE ${ARGN} GTest::gtest GTest::gtest_main)
  target_compile_definitions(${target} PRIVATE OTTISK_SOURCE_DIR="${CMAKE_SOURCE_DIR}" OTTISK_BINARY_DIR="${CMAKE_BINARY_DIR}")
  target_include_directories(${target} PRIVATE "${CMAKE_SOURCE_DIR}/src" "${CMAKE_SOURCE_DIR}/${dir}")
  ottisk_warnings(${target})
  add_dependencies(${target} qt_runtime)
  # В Release собираются только Ottisk render_refs render_tests bench (эталон 5.5): обнаружение
  # PRE_TEST падает на несобранном exe и роняет весь ctest, поэтому прочие gtest там не регистрируются.
  if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug" AND NOT target IN_LIST OTTISK_RELEASE_TEST_TARGETS)
    return()
  endif()
  string(REPLACE ";" "\\;" _labels "${labels}")
  gtest_discover_tests(${target}
    TEST_PREFIX "${prefix}."
    DISCOVERY_MODE PRE_TEST
    DISCOVERY_TIMEOUT 30
    XML_OUTPUT_DIR "${CMAKE_BINARY_DIR}/gtest-xml"
    PROPERTIES LABELS "${_labels}" TIMEOUT ${timeout})
endfunction()

# Окружение ctest для всех тестов каталога сборки.
function(ottisk_finalize_tests)
  set(_inc "${CMAKE_BINARY_DIR}/ottisk_test_env.cmake")
  # Пути — с прямыми слэшами (в строке CMake обратный слэш — экранирование); PATH дополняется
  # во время запуска ctest (\$ENV{PATH} в сгенерированном файле), а не значением на момент configure.
  set(_path "${QT_ROOT}/bin")
  if(OTTISK_ASAN_BIN)
    file(TO_CMAKE_PATH "${OTTISK_ASAN_BIN}" _asan)
    set(_path "${_asan};${_path}")
  endif()
  file(WRITE "${_inc}" "# generated by cmake/tests.cmake — test environment for all ctest tests
set(ENV{QT_QPA_PLATFORM} \"offscreen\")
set(ENV{QT_QPA_FONTDIR} \"C:/Windows/Fonts\")
set(ENV{QT_FORCE_STDERR_LOGGING} \"1\")
set(ENV{OTTISK_DATA_DIR} \"${OTTISK_TEST_DATA_DIR}\")
set(ENV{OTTISK_INSTANCE} \"test\")
set(ENV{OTTISK_SOURCE_DIR} \"${CMAKE_SOURCE_DIR}\")
set(ENV{PATH} \"${_path};\$ENV{PATH}\")
")
  string(REPLACE "\\" "/" _inc_fwd "${_inc}")
  set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${_inc_fwd}")
endfunction()

# Стражи-скрипты (эталон 9.5): код 0 — зелёный, 1 — красный, 77 — пропуск.
function(ottisk_guard name script)
  add_test(NAME unit.guard.${name}
    COMMAND "${OTTISK_PYTHON}" -X utf8 -I "${CMAKE_SOURCE_DIR}/tools/${script}" --root "${CMAKE_SOURCE_DIR}"
    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
  set_tests_properties(unit.guard.${name} PROPERTIES LABELS "unit;guard" SKIP_RETURN_CODE 77 TIMEOUT 120)
endfunction()
