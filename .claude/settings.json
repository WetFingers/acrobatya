{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Edit(./docs/design.md)",
      "Write(./docs/design.md)",
      "Edit(./docs/sessions.md)",
      "Write(./docs/sessions.md)",
      "Edit(./docs/tech-facts.md)",
      "Write(./docs/tech-facts.md)",
      "Edit(./docs/features.json)",
      "Write(./docs/features.json)",
      "Edit(./docs/features.md)",
      "Write(./docs/features.md)",
      "Edit(./tests/render/expected/**)",
      "Write(./tests/render/expected/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& ([IO.Path]::Combine([string][Environment]::GetEnvironmentVariable('CLAUDE_PROJECT_DIR'), '.claude\\hooks\\guard.ps1')); exit (Get-Variable -Name LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
